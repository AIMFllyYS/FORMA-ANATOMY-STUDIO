{
  "version": 1,
  "tools": [
    {
      "name": "get_scene",
      "description": "读取当前已加载结构、所选对象、相机、图层和学习状态。不会上传网格或私人笔记。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutatesCanvas": false,
      "zh": "读取场景",
      "icon": "layers"
    },
    {
      "name": "search_structures",
      "description": "在实际已加载的源对象中搜索中文或英文名称，返回稳定的当前会话对象编号。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "maxLength": 120 }
        },
        "additionalProperties": false,
        "required": ["query"]
      },
      "mutatesCanvas": false,
      "zh": "搜索结构",
      "icon": "search"
    },
    {
      "name": "get_structure_info",
      "description": "读取指定实际对象的本地学习提纲与来源；待审术语不是已完成的几何映射。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" }
        },
        "additionalProperties": false,
        "required": ["id"]
      },
      "mutatesCanvas": false,
      "zh": "结构提纲",
      "icon": "book"
    },
    {
      "name": "focus_structures",
      "description": "聚焦实际已加载的一个或多个对象；不新增结构。讲解该视角时请设置 hold_seconds（0–60，受设置上限约束，默认 12），以便停留画面并继续说明。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。讲解某一结构或方向时传入，停留期间继续用文字说明；下一次会改画面的工具会等到停留结束。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "聚焦结构",
      "icon": "focus"
    },
    {
      "name": "isolate_structures",
      "description": "单独显示实际对象，其他对象隐藏在本次视图之外。讲解该视角时请设置 hold_seconds（0–60，受设置上限约束，默认 12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "隔离显示",
      "icon": "isolate"
    },
    {
      "name": "highlight_structures",
      "description": "高亮实际源对象；不是给骨内部未标注的切迹自动划界。讲解该视角时请设置 hold_seconds（0–60，受设置上限约束，默认 12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "高亮结构",
      "icon": "sparkle"
    },
    {
      "name": "set_layer",
      "description": "调整一个已加载组织类别的显示及透明度。",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "skeletal",
              "joints",
              "muscles",
              "nerves",
              "organs",
              "vessels",
              "lymph",
              "other"
            ]
          },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false,
        "required": ["category"]
      },
      "mutatesCanvas": true,
      "zh": "调整图层",
      "icon": "layers"
    },
    {
      "name": "set_explode",
      "description": "调整当前可见对象的显示拆分程度；不是切碎单个骨或关节运动。",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "minimum": 0, "maximum": 1 },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。"
          }
        },
        "additionalProperties": false,
        "required": ["amount"]
      },
      "mutatesCanvas": true,
      "zh": "爆炸图",
      "icon": "explode"
    },
    {
      "name": "set_view",
      "description": "切换源坐标观察方向；未校准时不能声称解剖学前后左右。讲解该方向时请设置 hold_seconds（0–60，受设置上限约束，默认 12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": ["iso", "x", "nx", "y", "ny", "z", "nz"]
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。"
          }
        },
        "additionalProperties": false,
        "required": ["view"]
      },
      "mutatesCanvas": true,
      "zh": "切换视图",
      "icon": "cube"
    },
    {
      "name": "start_practice",
      "description": "进入本地测验，可选知识选择题或已加载源对象辨认题。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["theory", "identify"]
          }
        },
        "additionalProperties": false,
        "required": ["mode"]
      },
      "mutatesCanvas": true,
      "zh": "开始练习",
      "icon": "quiz"
    },
    {
      "name": "list_taxonomy",
      "description": "只读：按命名层浏览实际已加载结构的分类（系统→区域→功能群→亚群）与各组对象数、命名审校状态。不加载模型；缺料时用 get_scene 查看已载系统并提示用户载入。",
      "parameters": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "enum": ["skeletal", "joints", "muscles", "nerves", "organs", "vessels", "lymph"] },
          "group": { "type": "string", "maxLength": 60 }
        },
        "additionalProperties": false
      },
      "mutatesCanvas": false,
      "zh": "浏览分类",
      "icon": "layers"
    },
    {
      "name": "get_lesson",
      "description": "只读：读取关节课程数据（组装顺序、组成、教学运动、主动/拮抗肌群、教学近似轴锚点规则、六面观察建议、缺失字段）。关节 id 用 wrist/shoulder/elbow/radioulnar/hip/knee/ankle/spine。未加载的系统会在 missingSystems 中给出需要载入的系统名。",
      "parameters": {
        "type": "object",
        "properties": {
          "joint": { "type": "string", "enum": ["wrist", "shoulder", "elbow", "radioulnar", "hip", "knee", "ankle", "spine"] }
        },
        "additionalProperties": false,
        "required": ["joint"]
      },
      "mutatesCanvas": false,
      "zh": "读取课程",
      "icon": "book"
    },
    {
      "name": "set_highlight",
      "description": "按稳定命名 id 给已加载结构设置多态高亮：accent 强调（绿）、series 序列焦点（橙）、contraction 收缩态（红）。需用户批准；不改变位置。讲解时可配 hold_seconds 停留。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 100 },
          "state": { "type": "string", "enum": ["accent", "series", "contraction"] },
          "hold_seconds": { "type": "number", "minimum": 0, "maximum": 60, "description": "操作完成后在该视角停留的秒数（0–60，受设置上限约束，默认 12）。" }
        },
        "additionalProperties": false,
        "required": ["ids", "state"]
      },
      "mutatesCanvas": true,
      "zh": "多态高亮",
      "icon": "sparkle"
    },
    {
      "name": "play_assembly",
      "description": "播放课程组装序列：结构组从显示偏移逐步归位，伴随分组高亮与相机推近。传入关节 id（如 wrist）按课程顺序播放；也可用 steps 自定义 [{system, ids:[命名id], zh}]。显示偏移不修改源顶点。受动画总时长预算钳制。",
      "parameters": {
        "type": "object",
        "properties": {
          "joint": { "type": "string", "enum": ["wrist", "shoulder", "elbow", "radioulnar", "hip", "knee", "ankle", "spine"] },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "system": { "type": "string", "enum": ["skeletal", "joints", "muscles", "nerves", "organs", "vessels", "lymph"] },
                "ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 100 },
                "zh": { "type": "string", "maxLength": 80 }
              },
              "required": ["ids"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          },
          "step_seconds": { "type": "number", "minimum": 0.3, "maximum": 8 },
          "reverse": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "mutatesCanvas": true,
      "zh": "播放组装",
      "icon": "layers"
    },
    {
      "name": "play_joint_motion",
      "description": "播放关节教学运动：运动骨组按课程声明的教学近似轴（由真实已加载几何包围盒推导）在角度区间刚性往复，主动肌呈收缩态、拮抗肌序列态。始终是教学近似/刚性演示，非生理活动度与生物力学认证。锚点结构缺失时失败并中文提示，不静默换轴。受动画总时长预算钳制。",
      "parameters": {
        "type": "object",
        "properties": {
          "joint": { "type": "string", "enum": ["wrist", "shoulder", "elbow", "radioulnar", "hip", "knee", "ankle", "spine"] },
          "motion": { "type": "string", "maxLength": 60, "description": "课程内运动 id，如 flexion_extension / radial_ulnar_deviation" },
          "seconds": { "type": "number", "minimum": 0.5, "maximum": 20 },
          "loop": { "type": "integer", "minimum": 1, "maximum": 4 }
        },
        "additionalProperties": false,
        "required": ["joint", "motion"]
      },
      "mutatesCanvas": true,
      "zh": "关节运动",
      "icon": "rotate"
    },
    {
      "name": "camera_tour",
      "description": "相机编排：按视点序列定时切换并停留。view 用 iso/x/nx/y/ny/z/nz 源坐标方向；源模型朝向未校准前不得向用户称解剖学前后左右。受动画总时长预算钳制。",
      "parameters": {
        "type": "object",
        "properties": {
          "views": {
            "type": "array",
            "items": { "type": "string", "enum": ["iso", "x", "nx", "y", "ny", "z", "nz"] },
            "minItems": 1,
            "maxItems": 8
          },
          "hold_seconds": { "type": "number", "minimum": 0, "maximum": 10 }
        },
        "additionalProperties": false,
        "required": ["views"]
      },
      "mutatesCanvas": true,
      "zh": "相机编排",
      "icon": "cube"
    },
    {
      "name": "stop_animation",
      "description": "立即停止正在播放的组装/运动/相机动画，清除显示偏移与运动矩阵，恢复可交互状态。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutatesCanvas": true,
      "zh": "停止动画",
      "icon": "close"
    }
  ]
}
