{
  "version": 1,
  "tools": [
    {
      "name": "get_scene",
      "description": "读取当前已加载结构、所选对象、相机、图层和学习状态。不会上传网格或私人笔记。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutatesCanvas": false,
      "zh": "读取场景",
      "icon": "layers"
    },
    {
      "name": "search_structures",
      "description": "在实际已加载的源对象中搜索中文或英文名称，返回稳定的当前会话对象编号。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "maxLength": 120 }
        },
        "additionalProperties": false,
        "required": ["query"]
      },
      "mutatesCanvas": false,
      "zh": "搜索结构",
      "icon": "search"
    },
    {
      "name": "get_structure_info",
      "description": "读取指定实际对象的本地学习提纲与来源；待审术语不是已完成的几何映射。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" }
        },
        "additionalProperties": false,
        "required": ["id"]
      },
      "mutatesCanvas": false,
      "zh": "结构提纲",
      "icon": "book"
    },
    {
      "name": "focus_structures",
      "description": "聚焦实际已加载的一个或多个对象；不新增结构。讲解该视角时请设置 hold_seconds（0–12），以便停留画面并继续说明。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 12,
            "description": "操作完成后在该视角停留的秒数（0–12）。讲解某一结构或方向时传入，停留期间继续用文字说明；下一次会改画面的工具会等到停留结束。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "聚焦结构",
      "icon": "focus"
    },
    {
      "name": "isolate_structures",
      "description": "单独显示实际对象，其他对象隐藏在本次视图之外。讲解该视角时请设置 hold_seconds（0–12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 12,
            "description": "操作完成后在该视角停留的秒数（0–12）。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "隔离显示",
      "icon": "isolate"
    },
    {
      "name": "highlight_structures",
      "description": "高亮实际源对象；不是给骨内部未标注的切迹自动划界。讲解该视角时请设置 hold_seconds（0–12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 1,
            "maxItems": 100
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 12,
            "description": "操作完成后在该视角停留的秒数（0–12）。"
          }
        },
        "additionalProperties": false,
        "required": ["ids"]
      },
      "mutatesCanvas": true,
      "zh": "高亮结构",
      "icon": "sparkle"
    },
    {
      "name": "set_layer",
      "description": "调整一个已加载组织类别的显示及透明度。",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "skeletal",
              "joints",
              "muscles",
              "nerves",
              "organs",
              "vessels",
              "lymph",
              "other"
            ]
          },
          "visible": { "type": "boolean" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false,
        "required": ["category"]
      },
      "mutatesCanvas": true,
      "zh": "调整图层",
      "icon": "layers"
    },
    {
      "name": "set_explode",
      "description": "调整当前可见对象的显示拆分程度；不是切碎单个骨或关节运动。",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "minimum": 0, "maximum": 1 },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 12,
            "description": "操作完成后在该视角停留的秒数（0–12）。"
          }
        },
        "additionalProperties": false,
        "required": ["amount"]
      },
      "mutatesCanvas": true,
      "zh": "爆炸图",
      "icon": "explode"
    },
    {
      "name": "set_view",
      "description": "切换源坐标观察方向；未校准时不能声称解剖学前后左右。讲解该方向时请设置 hold_seconds（0–12）。",
      "parameters": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": ["iso", "x", "nx", "y", "ny", "z", "nz"]
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 12,
            "description": "操作完成后在该视角停留的秒数（0–12）。"
          }
        },
        "additionalProperties": false,
        "required": ["view"]
      },
      "mutatesCanvas": true,
      "zh": "切换视图",
      "icon": "cube"
    },
    {
      "name": "start_practice",
      "description": "进入本地测验，可选知识选择题或已加载源对象辨认题。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["theory", "identify"]
          }
        },
        "additionalProperties": false,
        "required": ["mode"]
      },
      "mutatesCanvas": true,
      "zh": "开始练习",
      "icon": "quiz"
    }
  ]
}
