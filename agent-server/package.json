{
  "name": "forma-agent-proxy",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Optional Vercel AI SDK 6 adapter for the self-contained Forma canvas. Provider credentials stay server-side.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "check": "node --check server.mjs && node --check protocol.mjs",
    "test": "node --test protocol.test.mjs tools-sync.test.mjs agent-config.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.75",
    "ai": "6.0.283",
    "ajv": "8.20.0"
  }
}
