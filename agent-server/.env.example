# Copy to .env. Keep .env out of version control. Never put provider keys in HTML.
HOST=127.0.0.1
PORT=8787
# OpenAI-compatible BASE URL, without /chat/completions. Local endpoints also work.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Set a model ID enabled on your chosen provider; no default model is assumed.
MODEL_ID=
# Comma-separated. Leave empty to allow only MODEL_ID.
ALLOWED_MODELS=
# Generate a random access token, distinct from MODEL_API_KEY. Required.
PROXY_TOKEN=
# Optional exact origins, comma-separated. No wildcard default.
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Keep false for production. With true, local file:// may call the proxy,
# still requiring PROXY_TOKEN; only supported while HOST is a loopback address.
ALLOW_FILE_ORIGIN=false
# Comma-separated hostnames permitted as client-supplied /relay upstreams
# (e.g. a Sub2API relay). PROXY_TOKEN is still required. Leave empty and the
# /relay branch only accepts client upstreams while HOST is a loopback bind;
# on a non-loopback bind a client-supplied upstream is refused with 403 until
# you list its host here. /relay itself is a zero-dependency pass-through: the
# browser talks only to this same-origin proxy, so no browser CORS is involved
# and the upstream's real error text is returned verbatim.
ALLOWED_UPSTREAM_HOSTS=
